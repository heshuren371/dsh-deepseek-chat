{
  "name": "@local/dsh-deepseek-chat",
  "version": "0.2.0",
  "description": "DSH Web 顶部 CHAT 模式切换：通过 Host 侧 loopback 反向代理把 chat.deepseek.com 嵌进 DSH Web（整窗口接管），顶部常驻〔对话 | CHAT〕胶囊随时切回原界面。",
  "license": "MIT",
  "author": "heshuren371",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heshuren371/dsh-deepseek-chat.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "deepseek-chat",
    "chat-mode",
    "mode-switch",
    "iframe",
    "reverse-proxy"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.24.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.0"
  }
}
